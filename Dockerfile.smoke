ARG GO_BASE_IMAGE=golang:1.26-bookworm

FROM ${GO_BASE_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        awscli \
        build-essential \
        coreutils \
        curl \
        git \
        python3-pip \
        python3-venv \
        ripgrep \
        rclone \
        rsync \
        rpcbind \
        nfs-common \
        nfs-ganesha \
        nfs-ganesha-mem \
        nfs-ganesha-vfs \
        samba \
        smbclient \
        strace \
        && python3 -m venv /opt/moto-venv \
        && /opt/moto-venv/bin/pip install 'moto[server]==5.0.16' \
        && ln -s /opt/moto-venv/bin/moto_server /usr/local/bin/moto_server \
        && ln -s /usr/local/go/bin/go /usr/local/bin/go \
        && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . .

CMD ["./smoke/run.sh"]
