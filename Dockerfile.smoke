ARG GO_BASE_IMAGE=golang:1.26-bookworm

FROM ${GO_BASE_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        awscli \
        build-essential \
        coreutils \
        curl \
        git \
        python3-pip \
        ripgrep \
        rclone \
        rsync \
        rpcbind \
        nfs-common \
        nfs-ganesha \
        nfs-ganesha-mem \
        nfs-ganesha-vfs \
        samba \
        smbclient \
        strace \
        && pip3 install --break-system-packages 'moto[server]==5.0.16' \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . .

CMD ["./smoke/run.sh"]
